{
  "schema": "islemind.complete-ui-experience-worklist.v1",
  "families": ["minimal", "monet", "material", "liquid-glass", "animal-island-ui"],
  "modes": ["light", "dark"],
  "viewports": [
    { "id": "mobile", "width": 390, "height": 844 },
    { "id": "desktop", "width": 1280, "height": 900 }
  ],
  "routes": [
    "/",
    "/agent",
    "/agent/run/[runId]",
    "/chat",
    "/chat/[id]",
    "/conversations",
    "/documents",
    "/documents/edit",
    "/help",
    "/help/[slug]",
    "/report",
    "/settings",
    "/settings/agents",
    "/settings/category/knowledge",
    "/settings/category/maintenance",
    "/settings/category/models",
    "/settings/category/personalization",
    "/settings/category/privacy",
    "/settings/category/tools",
    "/settings/context",
    "/settings/knowledge",
    "/settings/mcp",
    "/settings/memory",
    "/settings/model-availability",
    "/settings/preferences",
    "/settings/providers",
    "/settings/skills",
    "/settings/system/advanced",
    "/settings/system/appearance",
    "/settings/system/danger",
    "/settings/system/data",
    "/settings/system/diagnostics",
    "/settings/system/governance",
    "/settings/system/updates",
    "/settings/usage",
    "/source"
  ],
  "dynamicRouteState": "Absent conversation, run and source are real missing-data states. Detailed execution and report states are covered by component/domain tests, not these empty browser fixtures.",
  "nativeAcceptance": false
}
